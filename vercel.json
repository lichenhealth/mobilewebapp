{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "lichen.health" }],
      "destination": "/welcome/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.lichen.health" }],
      "destination": "https://lichen.health/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "lichen.healthcare" }],
      "destination": "https://lichen.health/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.lichen.healthcare" }],
      "destination": "https://lichen.health/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.lichen.health" }],
      "destination": "https://lichen.health/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "lichen.healthcare" }],
      "destination": "https://lichen.health/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.lichen.healthcare" }],
      "destination": "https://lichen.health/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/spaces/:id", "destination": "/api/page" },
    { "source": "/members/:id", "destination": "/api/page" },
    { "source": "/:handle([a-z0-9-]+)", "destination": "/api/page" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
