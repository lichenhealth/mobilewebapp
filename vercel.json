{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "lichen.health"
        }
      ],
      "destination": "/welcome/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.lichen.health"
        }
      ],
      "destination": "https://lichen.health/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "lichen.healthcare"
        }
      ],
      "destination": "https://lichen.health/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.lichen.healthcare"
        }
      ],
      "destination": "https://lichen.health/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.lichen.health"
        }
      ],
      "destination": "https://lichen.health/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lichen.healthcare"
        }
      ],
      "destination": "https://lichen.health/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.lichen.healthcare"
        }
      ],
      "destination": "https://lichen.health/:path*",
      "permanent": true
    },
    {
      "source": "/project/:slug",
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/weave",
      "destination": "/about",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/spaces/:id",
      "destination": "/api/page"
    },
    {
      "source": "/members/:id",
      "destination": "/api/page"
    },
    {
      "source": "/:handle((?!(?:about|admin|api|art|assets|assistant|b|blog|book|bookings|business|calendar|care-model|caregiver|chat|collections|communities|community|compose|concierge|conscious-economy|courses|directory|donate|drive|events|food|giving|groups|help|home|identities|invite|library|login|maps|market|members|membership|mission|mycelium|onboarding|opportunity|organizations|organize|ourstory|pilot|places|platform|privacy|profile|reset-password|resources|safety|saved|search|signup|snapshot|social-networks|spaces|terms|travel|vision|work)$)[A-Za-z0-9][A-Za-z0-9_-]*)",
      "destination": "/api/page"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
